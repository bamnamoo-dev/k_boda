{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismView",
  "version": "0.1.0",
  "identifier": "com.prismview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrismView",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "center": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jfif", "png", "gif", "webp", "avif", "bmp", "svg"],
        "name": "Image File",
        "description": "PrismView Image File",
        "role": "Viewer"
      },
      {
        "ext": ["zip", "cbz"],
        "name": "Comic Archive",
        "description": "PrismView Comic Archive",
        "role": "Viewer"
      }
    ]
  }
}
